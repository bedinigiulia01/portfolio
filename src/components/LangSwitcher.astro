---
import type { Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
  alternates: { lang: Lang; url: string }[];
}
const { lang, alternates } = Astro.props;
const order: Lang[] = ['en', 'fr', 'it'];
const items = order
  .map((l) => alternates.find((a) => a.lang === l))
  .filter(Boolean) as { lang: Lang; url: string }[];
---
<div class="lang">
  {items.map((a, i) => (
    <>
      <a
        href={a.url}
        class={a.lang === lang ? 'active' : ''}
        hreflang={a.lang}
        aria-current={a.lang === lang ? 'true' : undefined}
        data-link
      >{a.lang.toUpperCase()}</a>
      {i < items.length - 1 && <span class="sep">·</span>}
    </>
  ))}
</div>
