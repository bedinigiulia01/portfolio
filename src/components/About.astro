---
import type { Lang, UIKey } from '../i18n/ui';
export interface Props {
  lang: Lang;
  t: (key: UIKey) => string;
}
const { t } = Astro.props;
---
<section id="about">
  <div class="wrap">
    <div class="sec-head reveal"><span class="idx">(01)</span><h2>{t('about_title')}</h2><span class="rule"></span></div>
    <div class="about">
      <div class="col reveal">
        <p class="big" set:html={t('about_big')} />
      </div>
      <div class="col reveal">
        <p>{t('about_p1')}</p>
        <p>{t('about_p2')}</p>
        <div class="skills">
          <div class="row"><span>{t('sk1l')}</span><span>{t('sk1r')}</span></div>
          <div class="row"><span>{t('sk2l')}</span><span>Figma · Protopie · Notion</span></div>
          <div class="row"><span>{t('sk3l')}</span><span>{t('sk3r')}</span></div>
          <div class="row"><span>{t('sk4l')}</span><span>{t('sk4r')}</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(30px, 5vw, 80px); }
  @media (max-width: 820px) { .about { grid-template-columns: 1fr; } }
  .about .big { font-family: var(--font-display); font-weight: 330; font-size: clamp(24px, 2.8vw, 38px); line-height: 1.25; letter-spacing: -.015em; }
  .about .big :global(em) { font-style: italic; color: var(--muted); }
  .about .col p { font-family: var(--font-mono); font-size: 12.5px; line-height: 2; color: var(--muted); margin-bottom: 22px; }
  .about .skills { margin-top: 30px; border-top: 1px solid var(--line); }
  .about .skills .row { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; }
  .about .skills .row span:last-child { color: var(--muted); text-align: right; }
</style>
