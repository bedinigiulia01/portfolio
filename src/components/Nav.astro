---
import LangSwitcher from './LangSwitcher.astro';
import type { Lang, UIKey } from '../i18n/ui';

export interface Props {
  lang: Lang;
  t: (key: UIKey) => string;
  alternates: { lang: Lang; url: string }[];
}
const { lang, t, alternates } = Astro.props;
---
<nav id="nav">
  <div class="wrap">
    <div class="bar">
      <a href="#top" class="logo" data-link>Giulia Bedini<span class="dot">.</span></a>
      <div class="links">
        <a href="#about" data-link>{t('nav_about')}</a>
        <a href="#work" data-link>{t('nav_work')}</a>
        <a href="#contact" data-link>{t('nav_contact')}</a>
      </div>
      <LangSwitcher lang={lang} alternates={alternates} />
    </div>
  </div>
</nav>
