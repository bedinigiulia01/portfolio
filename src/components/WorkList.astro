---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { projects } from '../data/projects';
import type { Lang, UIKey } from '../i18n/ui';

export interface Props {
  lang: Lang;
  t: (key: UIKey) => string;
}
const { lang, t } = Astro.props;

// Card tags mirror the reference exactly (mix of literal + translated labels).
const cardTags: Record<string, string[]> = {
  'move-score': ['UX research', 'UI', t('tag_system'), 'Motion'],
  kinap: ['UX / UI', t('tag_mobile'), t('tag_branding')],
  dimagin: ['UX / UI', t('tag_web'), t('tag_system')],
};
const caseUrl = (slug: string) => getRelativeLocaleUrl(lang, `work/${slug}`);
---
<section id="work">
  <div class="wrap">
    <div class="sec-head reveal"><span class="idx">(02)</span><h2>{t('work_title')}</h2><span class="rule"></span></div>
    <div class="work">
      {projects.map((p, i) => (
        <article class={`proj reveal${i === 1 ? ' flip' : ''}`}>
          <a class="visual" href={caseUrl(p.slug)} data-link aria-label={`${p.name} — ${t('view_case')}`}>
            <div class="ph main"><img src={p.thumbMain} alt={`${p.name} — main screen`} loading="lazy" /></div>
            <div class="ph sub"><img src={p.thumbSub} alt={`${p.name} — secondary screen`} loading="lazy" /></div>
          </a>
          <div class="txt">
            <span class="vcap">Project {p.number}</span>
            <div class="pnum">{p.number}</div>
            <div class="pname">{p.name}<span class="dot">.</span></div>
            <p class="pdesc">{t(p.descKey)}</p>
            <div class="pmeta">
              <div><small>{t('lbl_role')}</small><b>{t(p.roleKey)}</b></div>
              <div><small>{t('lbl_year')}</small><b>{p.year}</b></div>
            </div>
            <div class="ptags">{cardTags[p.slug].map((tag) => <span>{tag}</span>)}</div>
            <a href={caseUrl(p.slug)} class="plink" data-link><span>{t('view_case')}</span><span class="ar">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work { display: flex; flex-direction: column; gap: clamp(70px, 11vw, 160px); }
  .proj { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(26px, 4vw, 64px); align-items: center; position: relative; }
  @media (max-width: 820px) { .proj { grid-template-columns: 1fr; gap: 30px; } }
  .proj.flip .visual { order: 2; }
  @media (max-width: 820px) { .proj.flip .visual { order: 0; } }
  .proj .visual { position: relative; }
  a.visual { display: block; }
  a.visual::after { content: "\2197"; position: absolute; z-index: 4; right: 16px; bottom: 16px; width: 46px; height: 46px; border-radius: 50%; background: var(--ink); color: var(--paper); display: flex; align-items: center; justify-content: center; font-size: 19px; opacity: 0; transform: translateY(8px) scale(.9); transition: opacity .45s var(--ease), transform .45s var(--ease); }
  a.visual:hover::after { opacity: 1; transform: none; }
  @media (pointer: coarse) { a.visual::after { opacity: 1; transform: none; } }
  .proj .visual .main { height: clamp(300px, 42vw, 540px); border-radius: 3px; }
  .proj .visual .main img { width: 100%; height: 100%; object-fit: cover; }
  .proj .visual .sub { position: absolute; width: 38%; height: 38%; bottom: -26px; border-radius: 3px; box-shadow: 0 24px 50px rgba(26,24,19,.18); }
  .proj:not(.flip) .visual .sub { right: -26px; }
  .proj.flip .visual .sub { left: -26px; }
  .proj .visual .sub img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 820px) { .proj .visual .sub { display: none; } }
  .proj .txt { position: relative; }
  .proj .vcap { position: absolute; writing-mode: vertical-rl; transform: rotate(180deg); font-family: var(--font-mono); font-size: 10px; letter-spacing: .32em; text-transform: uppercase; color: var(--vert); top: 0; left: -30px; }
  @media (max-width: 820px) { .proj .vcap { display: none; } }
  .proj .pnum { font-family: var(--font-display); font-style: italic; font-weight: 300; font-size: clamp(50px, 7vw, 100px); line-height: 1; color: var(--num); }
  .proj .pname { font-family: var(--font-display); font-weight: 360; font-size: clamp(32px, 4vw, 52px); letter-spacing: -.02em; margin: 4px 0 20px; }
  .proj .pdesc { font-family: var(--font-mono); font-size: 12.5px; line-height: 2; color: var(--muted); max-width: 40ch; }
  .proj .pmeta { display: flex; gap: 34px; margin: 26px 0 22px; flex-wrap: wrap; }
  .proj .pmeta div small { font-family: var(--font-mono); font-size: 9px; letter-spacing: .16em; text-transform: uppercase; color: var(--vert); display: block; margin-bottom: 5px; }
  .proj .pmeta div b { font-family: var(--font-display); font-weight: 400; font-size: 16px; }
  .proj .ptags { display: flex; gap: 9px; flex-wrap: wrap; }
  .proj .ptags span { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; border: 1px solid var(--num); padding: 7px 13px; border-radius: 30px; color: var(--muted); }
  .proj .plink { display: inline-flex; align-items: center; gap: 10px; margin-top: 30px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; border-bottom: 1px solid var(--ink); padding-bottom: 5px; }
  .proj .plink .ar { transition: transform .4s var(--ease); }
  .proj .plink:hover .ar { transform: translateX(7px); }
</style>
