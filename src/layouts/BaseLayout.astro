---
import '../styles/global.css';
import type { Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
  title: string;
  description: string;
  canonical: string;
  /** localized URLs of this same page, for hreflang + the language switcher */
  alternates: { lang: Lang; url: string }[];
}

const { lang, title, description, canonical, alternates } = Astro.props;
const hreflangMap: Record<string, string> = { en: 'en', fr: 'fr', it: 'it' };
const siteOrigin = Astro.site?.origin ?? '';
const abs = (u: string) => (siteOrigin ? new URL(u, siteOrigin).href : u);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(canonical)} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={hreflangMap[a.lang]} href={abs(a.url)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs(alternates.find((a) => a.lang === 'en')?.url ?? canonical)} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(canonical)} />
    <meta property="og:image" content={abs('/assets/hero.jpg')} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23f4f1ea'/%3E%3Ctext x='16' y='23' font-family='Georgia,serif' font-size='22' text-anchor='middle' fill='%231a1813'%3EG%3C/text%3E%3Ccircle cx='25' cy='21' r='2' fill='%23b8593a'/%3E%3C/svg%3E" />
  </head>
  <body>
    <div class="cursor" id="cursor" aria-hidden="true"></div>

    <slot />

    <script is:inline>
      (function () {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var fine = matchMedia('(pointer: fine)').matches;

        /* reveal-on-scroll + masked text */
        if (!reduce && 'IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
            });
          }, { threshold: 0.15 });
          document.querySelectorAll('.reveal, .mask').forEach(function (el) { io.observe(el); });
          window.addEventListener('load', function () {
            setTimeout(function () {
              document.querySelectorAll('.hero .mask').forEach(function (m) { m.classList.add('in'); });
            }, 120);
          });
        } else {
          document.querySelectorAll('.reveal, .mask').forEach(function (el) { el.classList.add('in'); });
        }

        /* nav scrolled state */
        var nav = document.getElementById('nav');
        if (nav) {
          addEventListener('scroll', function () { nav.classList.toggle('scrolled', scrollY > 40); }, { passive: true });
        }

        /* image parallax */
        if (!reduce) {
          var par = document.querySelectorAll('.proj .main, .heroimg');
          if (par.length) {
            addEventListener('scroll', function () {
              par.forEach(function (el) {
                var r = el.getBoundingClientRect();
                var off = (r.top + r.height / 2 - innerHeight / 2) / innerHeight;
                el.style.transform = 'translateY(' + (off * -18) + 'px)';
              });
            }, { passive: true });
          }
        }

        /* custom dot cursor */
        var cur = document.getElementById('cursor');
        if (cur && fine && !reduce) {
          document.body.classList.add('has-dot-cursor');
          addEventListener('mousemove', function (e) { cur.style.left = e.clientX + 'px'; cur.style.top = e.clientY + 'px'; });
          document.querySelectorAll('[data-link], a, button').forEach(function (el) {
            el.addEventListener('mouseenter', function () { cur.classList.add('grow'); });
            el.addEventListener('mouseleave', function () { cur.classList.remove('grow'); });
          });
        } else if (cur) {
          cur.style.display = 'none';
        }

        /* nav scroll-spy (home only) */
        var links = document.querySelectorAll('nav .links a');
        var secs = ['about', 'work', 'contact']
          .map(function (id) { return document.getElementById(id); })
          .filter(Boolean);
        if (links.length && secs.length && 'IntersectionObserver' in window) {
          var spy = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                var id = e.target.id;
                links.forEach(function (a) {
                  var on = a.getAttribute('href') === '#' + id;
                  a.classList.toggle('current', on);
                  if (on) { a.setAttribute('aria-current', 'true'); } else { a.removeAttribute('aria-current'); }
                });
              }
            });
          }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });
          secs.forEach(function (sec) { spy.observe(sec); });
        }
      })();
    </script>
  </body>
</html>
